# AI 配置
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_API_KEY=your_key_here
AI_MODEL=glm-4

# 通知配置 - Telegram
NOTIFY_TELEGRAM_BOT_TOKEN=your_bot_token
NOTIFY_TELEGRAM_CHAT_ID=your_chat_id

# 代理配置（国内访问 Telegram 可能需要）
# HTTP_PROXY=http://127.0.0.1:7890

# SSL 企业证书（Zscaler 等企业代理环境需要，留空则不启用）
# CA_CERT_FILE=/path/to/your/enterprise-cert.crt

# 调度配置（cron 表达式：分 时 日 月 周）
DAILY_REPORT_CRON=30 15 * * 1-5

# TradingView Alert Webhook 鉴权 secret(2026-08-12): 用户 Pine 策略 Alert POST /api/webhooks/tradingview 时须带 X-PanWatch-Secret 头
PANWATCH_TV_WEBHOOK_SECRET=

# 服务间只读 token(2026-09-08 T7): forecast 容器经此 token 读 /api/service/forecast-config
# (forecast_llm_* 配置 + 裁判场景绑定)。不设则 forecast 回落硬编码兜底模型并打告警。
# 留空时主服务会自动生成并入库, 但 forecast 侧拿不到 —— 生产建议显式设置。
SIDA_SERVICE_TOKEN=

# ─── compose 加固 2026-09-08 (T10): 以下两项缺失时 docker compose up 直接报错 ──

# PG 主库密码(强密码; 原 compose 有 sida_dev_only 弱默认静默兜底, 已改为强制)
POSTGRES_PASSWORD=

# Redis 密码(原 redis 无 requirepass, 主机任意进程可直读全部缓存; 已改为强制)
REDIS_PASSWORD=

# ─── 安全审计 2026-08-23 ──────────────────────────────────────────────────

# P0-2: 智兔公司简介接口 token。源码已删除硬编码 UUID fallback,
# 部署必须显式配置 (env / DB AppSettings.zhitu_token / marketdata 池化均可)。
# P1-15: 真实 key 不进仓库, 此处仅占位, 部署时填真实值并在智兔后台轮换已泄露 key。
ZHITU_TOKEN=YOUR_ZHITU_TOKEN_HERE

# P1-1: server.py 监听地址, 默认 127.0.0.1。Docker compose 已 expose/ports 转发,
# 主机裸跑只需 127 即可; 需公网直连(必须有前置反代)再显式设为 0.0.0.0。
WEB_HOST=127.0.0.1

# P1-4: forecast_server.py 监听地址, 默认 127.0.0.1。compose 网络由 8000 经
# FORECAST_ENGINE_URL=http://forecast:8010 访问, 无需主机网卡可达。
FORECAST_HOST=127.0.0.1

# P1-4: 可选鉴权。设了之后所有非 /health 请求需 Authorization: Bearer <key>。
# 不设则内部 systemd / curl probe 不会被打断。生产环境强烈建议设置。
# FORECAST_API_KEY=

# P1-2: docker-compose infra profile 启动 grafana 时必读, ${VAR:?err} 语法要求。
# docker compose --profile infra up 前必须设置, 否则 compose 直接报错。
GF_SECURITY_ADMIN_PASSWORD=

# ─── 安全审计 2026-09-15 (auth 凭证补全) ───────────────────────────────────

# JWT 签名密钥(≥32 字节, RFC 7518 HS256 建议)。不设则由 DB 自动生成并落库;
# 多容器部署(如 forecast 经 SIDA_MAIN_API_URL 调用)必须显式注入同一值。
# 生成示例: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# 首次启动管理员账号。不设则首启在 stderr 打印随机密码并引导自助改密。
# 生产环境强烈建议显式设置。
AUTH_USERNAME=
AUTH_PASSWORD=

# JWT 过期小时数, 默认 12 (不动, 桌面 App 静态 token 依赖)。如要缩短
# 需同步通知桌面端并准备滚动过渡。
# 注意: 环境变量名是 JWT_EXPIRE_HOURS, 不是 AUTH_JWT_EXPIRE_HOURS。
# JWT_EXPIRE_HOURS=12

# ─── 告警体系 2026-09-18 (tier1-compliance) ───────────────────────────────

# 企业微信群机器人 webhook 完整 URL(可选)。未配置时告警只写日志不外发。
# 例: https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxx
WECHAT_WEBHOOK_URL=

# 同一告警 key 冷却分钟数(默认 30)。窗口内重复触发只发一次。
# ALERT_COOLDOWN_MINUTES=30

# 5 分钟窗口内 5xx 次数阈值(默认 10), 超过触发 api_error_5xx。
# ALERT_5XX_THRESHOLD=10

# 5 分钟窗口内 LLM 429 次数阈值(默认 5), 超过触发 llm_rate_limit。
# ALERT_LLM_429_THRESHOLD=5

# 磁盘使用率告警阈值百分比(默认 85), 每小时检查 DATA_DIR 所在分区。
# ALERT_DISK_THRESHOLD_PCT=85

# 数据源连续失败次数阈值(默认 5), 超过触发 data_source_down。
# ALERT_DS_FAIL_THRESHOLD=5

# 数据库自动备份保留天数(默认 30)。每日 03:00 由 APScheduler 执行,
# 落盘 DATA_DIR/backups/backup_YYYYMMDD_HHMMSS.sql.gz。
# BACKUP_RETENTION_DAYS=30

# ─── P1 稳定性 2026-09-18 (Loki / APM / 读写分离) ──────────────────────────

# Loki 日志聚合推送地址(可选)。未配置时日志只走控制台 + DB, 行为不变。
# 例: http://loki:3100  (handler 会自动拼 /loki/api/v1/push)
# LOKI_URL=

# APM 追踪开关(默认开)。设 0 全关。
# APM_ENABLED=1

# APM 慢操作阈值毫秒(默认 1000)。超过打 WARNING + 计入 metrics。
# APM_SLOW_MS=1000

# APM 采样率 0~1(默认 1.0)。高 QPS 生产可降到 0.1 降开销。
# APM_SAMPLE_RATE=1.0

# ─── 数据库读写分离(可选) ────────────────────────────────────────────────
# 主库写连接串。优先于 SIDA_DB_URL; 都不设时回落默认 SQLite(本地开发)。
# DATABASE_URL_WRITE=postgresql+psycopg2://sida:xxx@panwatch-postgres:5432/sida

# 只读副本连接串(可选)。未配置时读写都走主库(向后兼容, 行为不变)。
# 配置后: SELECT 自动路由到读库, INSERT/UPDATE/DELETE 走写库。
# DATABASE_URL_READ=postgresql+psycopg2://sida:xxx@panwatch-postgres-ro:5432/sida

