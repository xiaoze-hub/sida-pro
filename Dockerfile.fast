# PanWatch Dockerfile (快速构建: 跳过前端构建, 用预构建 static/)
ARG PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.11-slim
ARG THSDK_IMAGE=ghcr.io/xiaoze-hub/thsdk-vendor:v1.7.18

FROM --platform=linux/amd64 ${THSDK_IMAGE} AS thsdk-vendor
FROM ${PYTHON_IMAGE}

ARG VERSION=dev
WORKDIR /app

RUN set -eux; \
    apt-get -o Acquire::Retries=8 -o Acquire::http::Timeout=120 update; \
    apt-get -o Acquire::Retries=8 -o Acquire::http::Timeout=120 install -y --no-install-recommends \
    tzdata git postgresql-client fonts-noto-cjk \
    libxcursor1 libgtk-3-0 libpangocairo-1.0-0 libnss3 libnspr4 libatk1.0-0 \
    libatk-bridge2.0-0 libcups2 libdrm2 libdbus-1-3 libxcb1 libxkbcommon0 \
    libx11-6 libxcomposite1 libxdamage1 libxext6 libxfixes3 libxrandr2 libgbm1 \
    libxss1 libasound2 libxshmfence1 libegl1 libfontconfig1 libglib2.0-0; \
    rm -rf /var/lib/apt/lists/*; fc-cache -fv

COPY requirements-lock.txt ./
RUN pip install --no-cache-dir --timeout 300 --retries 8 -i https://mirrors.aliyun.com/pypi/simple/ -r requirements-lock.txt && \
    python -c "from sqlalchemy import create_engine; assert create_engine"

COPY server.py ./
COPY prompts/ ./prompts/
COPY strategies/ ./strategies/
COPY src/ ./src/
COPY data_source/ ./data_source/
COPY packages/ ./packages/
RUN pip install --no-deps --no-cache-dir -e ./packages/marketdata && \
    python -c "from marketdata.vendors.tencent_panel import fetch_price_distribution; assert fetch_price_distribution"

COPY --from=thsdk-vendor /thsdk/ /usr/local/lib/python3.11/site-packages/thsdk/

COPY VERSION ./
RUN VERSION_VAL="${VERSION}"; \
    if [ "${VERSION}" = "dev" ] && [ -f VERSION ] && [ -s VERSION ]; then \
      VERSION_VAL="$(cat VERSION | tr -d '[:space:]')"; \
    fi; \
    printf '%s\n' "${VERSION_VAL}" > VERSION && test -s VERSION

COPY static/ ./static/

RUN groupadd -r -g 10001 app && useradd -r -u 10001 -g app -d /app -s /sbin/nologin app
RUN mkdir -p /app/data && chown -R app:app /app

RUN find /usr/local/lib/python3.11/site-packages /app -name "__pycache__" -type d -prune -exec rm -rf {} + 2>/dev/null || true; \
    rm -rf /usr/local/lib/python3.11/site-packages/pip /usr/local/lib/python3.11/site-packages/pip-* 2>/dev/null || true

ENV PYTHONUNBUFFERED=1 DATA_DIR=/app/data DOCKER=1 PYTHONDONTWRITEBYTECODE=1 TZ=Asia/Shanghai
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=30s --start-period=90s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/health')" || exit 1
USER app
CMD ["python", "server.py"]
