[Unit]
Description=PanWatch A-Share Forecast Engine (Kronos + XGBoost + Chronos-Bolt + TimesFM + LinearReg)
Documentation=file:/opt/panwatch-forecast/forecast_server.py
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/panwatch-forecast
# 引擎经主服务(8000, 已发布到宿主机)拿资金流/裁判配置; 历史库落 FORECAST_DB_PATH。
# 该文件由 deploy/deploy_forecast_engine.sh 生成(单一来源, 勿手改)。
EnvironmentFile=/opt/panwatch-forecast/forecast.env
ExecStart=/opt/panwatch-forecast/venv/bin/python3 /opt/panwatch-forecast/forecast_server.py
Restart=always
RestartSec=5
# 预测引擎内存占用大(Kronos ~1GB), 给足上限与慢启动时间
MemoryMax=4G
TimeoutStartSec=300
# 日志
StandardOutput=append:/var/log/panwatch-forecast.log
StandardError=append:/var/log/panwatch-forecast.log

[Install]
WantedBy=multi-user.target
